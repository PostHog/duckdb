# name: test/sql/types/variant/variant_parquet_shredding_setting.test
# description: The parquet writer honors variant_minimum_shredding_size
# group: [variant]

require parquet

require json

statement ok
CREATE TABLE src AS SELECT try_cast(try_cast('{"a": ' || i || ', "b": "x"}' AS JSON) AS VARIANT) v FROM range(20) t(i);

# -1 disables shredding entirely: the file holds only metadata + value, no typed_value
statement ok
SET variant_minimum_shredding_size=-1;

statement ok
COPY src TO '{TEST_DIR}/variant_noshred.parquet' (FORMAT PARQUET);

query I
SELECT count(*) FROM parquet_schema('{TEST_DIR}/variant_noshred.parquet') WHERE name='typed_value';
----
0

# unshredded files stay readable, including field extraction
query II
SELECT count(*), max(v.a::INT) FROM read_parquet('{TEST_DIR}/variant_noshred.parquet');
----
20	19

# below the minimum row count: no shredding (same semantics as the storage checkpoint path)
statement ok
SET variant_minimum_shredding_size=100;

statement ok
COPY src TO '{TEST_DIR}/variant_below.parquet' (FORMAT PARQUET);

query I
SELECT count(*) FROM parquet_schema('{TEST_DIR}/variant_below.parquet') WHERE name='typed_value';
----
0

# at/above the minimum row count: auto-shredding still happens
statement ok
SET variant_minimum_shredding_size=10;

statement ok
COPY src TO '{TEST_DIR}/variant_shred.parquet' (FORMAT PARQUET);

query I
SELECT count(*) > 0 FROM parquet_schema('{TEST_DIR}/variant_shred.parquet') WHERE name='typed_value';
----
true

# shredded files read back identically
query II
SELECT count(*), max(v.a::INT) FROM read_parquet('{TEST_DIR}/variant_shred.parquet');
----
20	19
