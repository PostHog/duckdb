# name: test/parquet/variant/pushdown/variant_extract_casts.test
# group: [pushdown]

require parquet

statement ok
COPY (
	FROM (
		VALUES
			({'x': 5::SMALLINT}::VARIANT),
			({'x': 6::SMALLINT}::VARIANT),
			({'x': '5'}::VARIANT),
			({'x': NULL}::VARIANT)
	) t(v)
) TO '{TEST_DIR}/variant_pushdown_casts.parquet' (
	SHREDDING {'v': 'STRUCT(x SMALLINT)'}
);

statement ok
COPY (
	FROM (
		VALUES
			({'x': 4::UTINYINT}::VARIANT),
			({'x': 5::UTINYINT}::VARIANT),
			({'x': 6::UTINYINT}::VARIANT),
			({'x': '5'}::VARIANT)
	) t(v)
) TO '{TEST_DIR}/variant_pushdown_casts_unsigned.parquet';

statement ok
COPY (
	FROM (
		VALUES
			({'x': 5::SMALLINT}::VARIANT),
			({'x': 6::SMALLINT}::VARIANT),
			({'x': NULL}::VARIANT)
	) t(v)
) TO '{TEST_DIR}/variant_pushdown_casts_fully.parquet' (
	SHREDDING {'v': 'STRUCT(x SMALLINT)'}
);

# 1.5.5 port note: direct mixed-type variant comparison requires main's nested-comparison
# semantics (#24037, ships with 1.6); on 1.5.5 it raises an Invalid Input Error.
statement error
SELECT count(*) FILTER (WHERE v.x = 5::INTEGER)
FROM '{TEST_DIR}/variant_pushdown_casts.parquet';
----
explicit cast

query III
SELECT
	count(*) FILTER (WHERE v.x::SMALLINT = 5),
	count(*) FILTER (WHERE v.x::BIGINT = 5),
	count(*) FILTER (WHERE TRY(v.x::INTEGER) = 5)
FROM '{TEST_DIR}/variant_pushdown_casts.parquet'
----
2	2	2

# 1.5.5 port note: runs against the fully-shredded file — the mixed-type comparison
# against the partially-shredded file raises on 1.5.5 (see above).
query ITT
SELECT v.x::SMALLINT, v.x::BIGINT::VARCHAR, v.x::VARCHAR
FROM '{TEST_DIR}/variant_pushdown_casts_fully.parquet'
WHERE v.x = 5::INTEGER
----
5	5	5

query II
SELECT
	count(*) FILTER (WHERE v.x::VARCHAR = '5'),
	count(*) FILTER (WHERE TRY(v.x::INTEGER) IS NULL)
FROM '{TEST_DIR}/variant_pushdown_casts.parquet'
----
2	1

# 1.5.5 port note: variant-to-variant comparison over mixed inner types raises on 1.5.5
# (main's #24037 nested-comparison semantics ship with 1.6).
statement error
SELECT count(*)
FROM '{TEST_DIR}/variant_pushdown_casts.parquet'
WHERE v.x = '5'::VARIANT
----
explicit cast

# 1.5.5 port note: this file mixes numeric and string field values; the mixed
# comparison raises on 1.5.5 (see above).
statement error
SELECT count(*)
FROM '{TEST_DIR}/variant_pushdown_casts_unsigned.parquet'
WHERE v.x = 5::INTEGER
----
explicit cast

query III
SELECT
	count(*) FILTER (WHERE v.x = 5::INTEGER),
	count(*) FILTER (WHERE v.x::SMALLINT = 5),
	count(*) FILTER (WHERE v.x::BIGINT = 5)
FROM '{TEST_DIR}/variant_pushdown_casts_fully.parquet'
----
1	1	1
